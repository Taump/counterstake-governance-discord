# Testnet configuration. Copy to .env, fill in the Discord credentials, and start the bot
# with a separate data directory (see below).
testnet=1

discord_token=
channel=

# Only BSC testnet currently has Counterstake bridges, but every network listed here needs a
# reachable node: the bot opens a websocket provider for each one at startup and exits if a
# URL is missing. Endpoints below are verified: Sepolia (chain 11155111), BSC testnet (97),
# Amoy (80002), Kava testnet (2221).
ws_nodes_Ethereum = "wss://ethereum-sepolia-rpc.publicnode.com"
ws_nodes_BSC = "wss://bsc-testnet-rpc.publicnode.com"
ws_nodes_Polygon = "wss://polygon-amoy-bor-rpc.publicnode.com"
ws_nodes_Kava = "wss://wevm.testnet.kava.io"

# Used by the EVM event scanner.
scan_start_date = "2026-09-01T00:00:00Z"
address_scan_interval_hours = "12"
